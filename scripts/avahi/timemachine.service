<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">

<!--
  Announces the Samba container's Time Machine shares over mDNS, so the
  MacBooks list them in System Settings → Time Machine without mounting
  anything first. Installed to /etc/avahi/services/ by
  scripts/setup/04-setup-avahi.sh (Avahi runs on the host, not in Docker).

  adVN= must equal a share name in services/samba/timemachine.conf.
  adVF=0x82 marks a share reachable over SMB; sys=adVF=0x100 marks the
  server as a Time Machine target.
-->

<service-group>

  <name replace-wildcards="yes">%h</name>

  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>

  <service>
    <type>_device-info._tcp</type>
    <port>0</port>
    <txt-record>model=TimeCapsule8,119</txt-record>
  </service>

  <service>
    <type>_adisk._tcp</type>
    <port>9</port>
    <txt-record>sys=waMa=0,adVF=0x100</txt-record>
    <txt-record>dk0=adVN=TimeMachine-andrew,adVF=0x82</txt-record>
    <txt-record>dk1=adVN=TimeMachine-yuliia,adVF=0x82</txt-record>
  </service>

</service-group>
